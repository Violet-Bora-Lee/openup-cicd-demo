{
  "name": "openup-cicd-demo",
  "version": "1.0.0",
  "description": "Open UP × 고려대 입문형 강의 데모 — TypeScript 추론 API + Jest + GitHub Actions",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
